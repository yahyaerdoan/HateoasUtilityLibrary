<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>Hateoas.AspNetCore</PackageId>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Hateoas - ASP.NET Core</Title>
    <Version>2.1.0</Version>
    <Product>Hateoas.AspNetCore</Product>
    <Description>ASP.NET Core integration for Hateoas: one LinkProvider per resource type applied automatically to every endpoint response by an endpoint filter (items, lists, pages, nested), route-name based hrefs that fail loudly when unresolvable, state- and permission-aware conditional links, CURIE-prefixed extension relations, Location on 201 Created and RFC 8288 Link headers on paged collections.</Description>
    <PackageTags>Hateoas HAL Hypermedia REST RichardsonMaturityModel AspNetCore Links</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hateoas\Hateoas.csproj" />
  </ItemGroup>

</Project>
