<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Hateoas.AspNetCore.OpenApi</PackageId>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Hateoas - OpenAPI</Title>
    <Version>2.2.0</Version>
    <Product>Hateoas.AspNetCore.OpenApi</Product>
    <Description>Microsoft.AspNetCore.OpenApi support for Hateoas: documents HAL "_links" as written (a map of links by relation plus "curies") instead of the empty object the schema generator sees through the custom converter.</Description>
    <PackageTags>Hateoas HAL Hypermedia REST AspNetCore OpenApi Links</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hateoas.AspNetCore\Hateoas.AspNetCore.csproj" />
  </ItemGroup>

</Project>
